#!/usr/bin/env bash
# start-feature — create & bootstrap per-feature worktrees across repos
# Usage: start-feature <subdir> <branch> <repo> [repo ...]
#   <subdir>  directory under ~/dev/glade/per-feature/ to hold the worktrees
#   <branch>  branch name for every worktree
#   <repo...> one or more repo names (resolved under core/ then utility/) or paths
#
# Thin front-end over setup-worktree: makes the per-feature dir, then fans one
# setup-worktree per repo out in parallel (each hits a different source repo, so
# no contention) and prints a pass/fail summary.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SETUP_WORKTREE="$SCRIPT_DIR/setup-worktree"
PER_FEATURE="$HOME/dev/glade/per-feature"
CORE="$HOME/dev/glade/core"
UTILITY="$HOME/dev/glade/utility"
AWS_PROFILE_NAME="staging-admin"

# ── colours ──────────────────────────────────────────────────────────────────
bold=$(tput bold 2>/dev/null || echo "")
reset=$(tput sgr0 2>/dev/null || echo "")
green=$(tput setaf 2 2>/dev/null || echo "")
yellow=$(tput setaf 3 2>/dev/null || echo "")
cyan=$(tput setaf 6 2>/dev/null || echo "")
red=$(tput setaf 1 2>/dev/null || echo "")

die() { echo "${red}error:${reset} $*" >&2; exit 1; }

# ── args ─────────────────────────────────────────────────────────────────────
SUBDIR="${1:-}"
BRANCH="${2:-}"
[[ -z "$SUBDIR" || -z "$BRANCH" || $# -lt 3 ]] \
  && die "usage: start-feature <subdir> <branch> <repo> [repo ...]"
shift 2
REPOS=("$@")

[[ -x "$SETUP_WORKTREE" ]] || die "setup-worktree not found/executable at $SETUP_WORKTREE"

# ── validate repos up front (fast fail before spawning anything) ─────────────
for repo in "${REPOS[@]}"; do
  if [[ -d "$repo/.git" || -f "$repo/.git" || -d "$CORE/$repo" || -d "$UTILITY/$repo" ]]; then
    continue
  fi
  die "repo '$repo' not found under $CORE or $UTILITY (and not a git path)"
done

# ── aws preflight (once, for a clean early exit) ─────────────────────────────
echo "${cyan}Checking AWS profile '$AWS_PROFILE_NAME'…${reset}"
aws sts get-caller-identity --profile "$AWS_PROFILE_NAME" >/dev/null 2>&1 \
  || die "not logged in to AWS profile '$AWS_PROFILE_NAME'. Run: ${bold}aws sso login --profile $AWS_PROFILE_NAME${reset}"

# ── set up ───────────────────────────────────────────────────────────────────
DEST_ROOT="$PER_FEATURE/$SUBDIR"
LOGDIR="$DEST_ROOT/.setup-logs"
mkdir -p "$LOGDIR"

echo "${bold}Feature:${reset} $SUBDIR   ${bold}branch:${reset} ${cyan}$BRANCH${reset}"
echo "${bold}Repos:${reset}   ${REPOS[*]}"
echo "Worktrees → $DEST_ROOT"
echo ""

declare -a NAMES=() PIDS=() LOGS=()
for repo in "${REPOS[@]}"; do
  name="$(basename "$repo")"
  log="$LOGDIR/$name.log"
  echo "  ${cyan}starting${reset} $name (log: $log)"
  "$SETUP_WORKTREE" "$repo" "$BRANCH" "$DEST_ROOT/$name" >"$log" 2>&1 &
  NAMES+=("$name"); PIDS+=("$!"); LOGS+=("$log")
done

# ── wait & report ────────────────────────────────────────────────────────────
echo ""
echo "${bold}Results:${reset}"
FAIL=0
for i in "${!PIDS[@]}"; do
  if wait "${PIDS[$i]}"; then
    printf "  %-28s %s\n" "${NAMES[$i]}" "${green}OK${reset}"
  else
    printf "  %-28s %s  (see %s)\n" "${NAMES[$i]}" "${red}FAILED${reset}" "${LOGS[$i]}"
    FAIL=1
  fi
done

echo ""
if [[ $FAIL -eq 0 ]]; then
  echo "${green}${bold}Done.${reset} Worktrees at $DEST_ROOT"
else
  echo "${yellow}${bold}Done with failures.${reset} Check the logs above."
  exit 1
fi
